{
  "devDependencies": {
    "void": "^1.3.0",
    "vite": "^8.0.10",
    "typescript": "^7.0.2",
    "@void/react": "1.3.0",
    "oxc-transform-react": "^0.149.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  },
  "name": "r5-remote-agent",
