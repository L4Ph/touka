{
  "name": "r5-remote-agent",
  "private": true,
  "workspaces": [
    "server",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp -C . dev",
    "verify:web": "npm run build && npm run build:server && npx tsc --noEmit && cd server && node --import tsx --test web-test/*.test.ts",
    "test": "npm test --workspace server",
    "verify:discord": "npm run typecheck --workspace @remote-agent/adapter-discord && npm run test --workspace @remote-agent/adapter-discord && npm run build:server && cd server && node --import tsx --test test/discord.test.ts",
    "verify:auth": "npm run build && npm run build:server && cd server && node --import tsx --test auth-test/auth.test.ts",
    "verify:models": "npm run verify:models --workspace server",
    "verify:delivery": "npm run verify:delivery --workspace server",
    "verify:pilot": "npm run verify:pilot --workspace server",
    "verify:stream": "npm run verify:stream --workspace server",
    "verify:sessions": "npm run verify:sessions --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspace server",
    "build:server": "npm run build --workspace server",
    "verify": "npm run verify --workspace server && npm run build",
    "build": "vp -C . build",
    "preview": "vp -C . preview",
    "postinstall": "void prepare"
  },
  "dependencies": {
    "hono": "^4.11.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@void/react": "1.3.0",
    "oxc-transform-react": "^0.149.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "void": "^1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
