{
  "name": "r5-remote-agent",
  "private": true,
  "workspaces": [
    "server",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "build:server": "vp -C server build",
    "build:all": "vp build && vp -C server build",
    "test": "vp test",
    "check": "vp check",
    "verify": "vp run build:all && vp test && vp check",
    "preview": "vp preview",
    "postinstall": "void prepare"
  },
  "dependencies": {
    "hono": "^4.11.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@void/react": "1.3.0",
    "oxc-transform-react": "^0.149.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "void": "^1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "packageManager": "npm@11.20.0"
}
