# Server-only settings. Copy desired keys into your shell or server/.dev.vars.
# No credentials belong in root VITE_* variables or browser storage.
# TEAM_AUTH is a JSON array: each member needs id, token (>=32 chars), sessions and resources.
# Use independent random tokens. Empty/missing/invalid configuration returns 503.
TEAM_AUTH=
MODEL_PROVIDER=
MODEL_ID=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Doctor/Drive only; use the same team token and an explicitly allowed session.
AGENT_URL=http://127.0.0.1:8787
AGENT_TOKEN=
AGENT_SESSION=
# Reserved for later modules; not consumed by the spine.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
