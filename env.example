# Server-only settings: use server/.dev.vars locally or Worker secrets in production.
# No credentials belong in client-visible variables or chat messages.
# TEAM_AUTH JSON: each principal needs id, token (>=32 chars), sessions and resources.
# Management listing and access require explicit session IDs, including Trigger-created IDs.
# Use independent random tokens. Empty/missing/invalid configuration returns 503.
TEAM_AUTH=
MODEL_PROVIDER=
MODEL_ID=
# Any pi-ai builtin provider is selectable, using that provider's SDK env names.
# Example: MODEL_PROVIDER=groq, MODEL_ID=llama-3.3-70b-versatile and GROQ_API_KEY.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional server-only JSON ProviderConfig[]; see README operator provider example.
# No inline credentials. auth.env names any server secret binding; auth.keyless is explicit.
MODEL_PROVIDERS=
TEAM_INFERENCE_SECRET=
# Optional pi-ai cloudflare-ai-gateway provider; all three required only for that provider.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
# Optional remote MCP tools; see packages/connector-mcp/README.md.
# Example JSON: [{"id":"docs","url":"https://mcp.example.com/mcp","tools":["search"],"headers":{"Authorization":"MCP_DOCS_AUTH"}}]
# Explicit per-session resource grant also required: mcp:docs:search.
MCP_SERVERS=[]
# Secret value includes the scheme, e.g. Bearer <token>. Never use a VITE_* variable.
MCP_DOCS_AUTH=
# Doctor/Drive only; use the same team token and an explicitly allowed session.
AGENT_URL=http://127.0.0.1:8787
AGENT_TOKEN=
AGENT_SESSION=
# Connector credentials and Trigger policy are server-only; missing config fails closed.
# Trigger startup is not tool write authority. Only explicit server resource policy grants it.
# See server/src/README.md for module contracts and acceptance-time grants.
SLACK_SIGNING_SECRET=
# Secret JSON workspace/actor/token/resources policy; see packages/trigger-slack/README.md.
SLACK_WORKSPACES=
SLACK_ADMIN_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Connector GitHub: exact JSON owner/repo -> installation ID map, shared by Tool and Trigger.
GITHUB_REPOSITORIES=
GITHUB_ACTORS=
GITHUB_BOT_LOGIN=
# Discord HTTP /ask only. Both guild and actor required; DMs/Gateway mentions unsupported.
# See packages/trigger-discord/README.md. Interaction tokens persist only in private outbox.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILDS=
DISCORD_ADMIN_TOKEN=
# Offline registration script only; not needed by the running server.
DISCORD_REGISTER_GUILD=
# Private bindings in server/wrangler.jsonc: SESSIONS, TRIGGER_JOBS, SANDBOX.
# Sandbox container images must be provisioned explicitly; see server/src/tools/sandbox/README.md.
