# Server-only settings. Core keys go in server/.dev.vars; Web keys below go in root .dev.vars.
# Better Auth Web Worker only; no VITE_* prefix. Exact verified emails, fail closed if empty.
TEAM_EMAILS=
BETTER_AUTH_SECRET=
# Default Web social provider is GitHub (void.config.ts); distinct from the bot GitHub App.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# Root AGENT_CORE service binding -> core named WebGateway; no public secret-bearing URL.
# Core: migration IDs for pre-index adapter conversations absent from machine allowlists.
SESSION_INDEX_SEEDS=[]
# Core: resources for NEW Web-bound conversations only; existing adapter grants are retained.
WEB_RESOURCES=[]
# No credentials belong in root VITE_* variables or browser storage.
# MACHINE-ONLY TEAM_AUTH JSON: each principal needs id, token (>=32 chars), sessions and resources.
# Human viewers use Better Auth, never this token, and share the durable team session directory.
# Use independent random tokens. Empty/missing/invalid configuration returns 503.
TEAM_AUTH=
MODEL_PROVIDER=
MODEL_ID=
# Any pi-ai builtin provider is selectable, using that provider's SDK env names.
# Example: MODEL_PROVIDER=groq, MODEL_ID=llama-3.3-70b-versatile and GROQ_API_KEY.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional server-only JSON ProviderConfig[]; see README operator provider example.
# No inline credentials. auth.env names any server secret binding; auth.keyless is explicit.
MODEL_PROVIDERS=
TEAM_INFERENCE_SECRET=
# Optional pi-ai cloudflare-ai-gateway provider; all three required only for that provider.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
# Doctor/Drive only; use the same team token and an explicitly allowed session.
AGENT_URL=http://127.0.0.1:8787
AGENT_TOKEN=
AGENT_SESSION=
# Adapter settings are server-only; missing configuration must fail closed.
# See server/src/README.md for module contracts and acceptance-time grants.
SLACK_SIGNING_SECRET=
# Secret JSON workspace/actor/token/resources policy; see packages/adapter-slack/README.md.
SLACK_WORKSPACES=
SLACK_ADMIN_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Exact JSON owner/repo -> installation ID map, shared by tools and adapter auth.
GITHUB_REPOSITORIES=
GITHUB_ACTORS=
GITHUB_BOT_LOGIN=
# Discord HTTP /ask only. Both guild and actor required; DMs/Gateway mentions unsupported.
# See packages/adapter-discord/README.md. Interaction tokens persist only in private outbox.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILDS=
DISCORD_ADMIN_TOKEN=
# Offline registration script only; not needed by the running server.
DISCORD_REGISTER_GUILD=
# Private bindings in server/wrangler.jsonc: SESSIONS, SESSION_DIRECTORY, ADAPTER_JOBS, SANDBOX.
# Sandbox container images must be provisioned explicitly; see server/src/tools/sandbox/README.md.
