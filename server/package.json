{
  "name": "@remote-agent/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "vp build",
    "typecheck": "tsc --noEmit",
    "lint": "cd .. && vp lint server/src server/test shared packages",
    "test": "node scripts/test.mjs",
    "verify:models": "npm run build && vpx --test test/models.test.ts",
    "verify:delivery": "vpx --test test/delivery.test.ts",
    "verify:pilot": "npm run build && vpx --test test/contracts.test.ts test/pilot.test.ts",
    "verify:stream": "npm run build && vpx --test test/stream.test.ts",
    "verify:sessions": "npm run build && vpx --test test/sessions.test.ts test/pilot.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test",
    "launch": "node scripts/runtime.mjs launch",
    "doctor": "node scripts/runtime.mjs doctor",
    "drive": "node scripts/runtime.mjs drive",
    "cleanup": "node scripts/runtime.mjs cleanup"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^1.0.3",
    "@earendil-works/chord": "~1.4.0",
    "@earendil-works/pi-ai": "~1.4.0",
    "@earendil-works/pi-durable": "~1.4.0",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@remote-agent/adapter-contract": "*",
    "@remote-agent/adapter-discord": "*",
    "@remote-agent/adapter-slack": "*",
    "@remote-agent/adapter-webhook": "*",
    "agents": "^0.30.1",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/node": "^26.6.5",
    "miniflare": "^4.20260730.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  }
}
